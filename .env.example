# Public URL of this deployment (used in checkout links, OAuth callbacks and webhook URLs)
APP_URL=https://your-app.vercel.app

# Signs checkout links and OAuth state. Generate: openssl rand -hex 32
LINK_SIGNING_SECRET=

# Encrypts merchant tokens/API keys at rest. 32 bytes: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Supabase (run supabase/migrations/0001_init.sql first). Without these, an in-memory demo store is used locally.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron sends this as a Bearer token to /api/cron/sync
CRON_SECRET=

# Salla app (Partners portal): Easy Mode, webhook URL = {APP_URL}/api/webhooks/salla, security strategy = Signature
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_WEBHOOK_SECRET=

# Zid app (Partner Dashboard): callback/redirect = {APP_URL}/api/connect/zid/callback
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
# Any long random string; signs the token in each Zid webhook target URL
ZID_WEBHOOK_SECRET=

# Local only: set DEMO_DATA=0 to start the memory store empty. ALLOW_MEMORY_DB=1 allows the memory store in production (demo only).
# DEMO_DATA=0
# ALLOW_MEMORY_DB=1
