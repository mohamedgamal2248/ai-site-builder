# Optional. Defaults to Pi's public Horizon servers.
PI_MAINNET_HORIZON=https://api.mainnet.minepi.com
PI_TESTNET_HORIZON=https://api.testnet.minepi.com

# Statistics (phase 2). Postgres connection string; with Supabase use the pooler URL (port 6543).
DATABASE_URL=
# Secret for /api/cron/ingest (Vercel Cron sends it automatically as a bearer token).
CRON_SECRET=
# Native Pi transfers at or above this amount are listed on /largest.
LARGE_PAYMENT_MIN=10000
